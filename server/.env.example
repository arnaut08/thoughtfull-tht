PORT=3001
NODE_ENV=development
# Browser origin allowed to call the API (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secret used to sign JWT access tokens. Use a long random string.
JWT_SECRET=
# Token lifetime, as a zeit/ms string such as 1h or 7d
JWT_EXPIRES_IN=1h
